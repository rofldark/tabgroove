{
  "manifest_version": 3,
  "name": "TabGroove",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "TabGroove – Two tabs. Your mix. Crossfade between two YouTube tabs like a DJ.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TabGroove",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "scripting",
    "tabs",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ]
}
